# ─ Google 로그인 (Google Cloud 콘솔 > 사용자 인증 정보 > OAuth 클라이언트 ID, 웹 애플리케이션)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 로그인할 수 있는 Google 계정 (쉼표로 여러 개). 다른 계정은 로그인 후 설정에서 연결한다.
ALLOWED_EMAILS=you@gmail.com

# 세션 서명·토큰 암호화 키. 32자 이상 무작위 문자열:  openssl rand -base64 48
SESSION_SECRET=

# 맥 에이전트·휴대폰이 데이터를 보낼 때 쓰는 토큰:  openssl rand -base64 32
INGEST_TOKEN=

# 배포 주소 (예: https://today.example.com). 비우면 요청 주소를 쓴다.
APP_URL=

# ─ 저장소: Vercel 마켓플레이스의 Upstash Redis를 연결하면 자동으로 들어간다. 비우면 .data/store.json 파일을 쓴다.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# 환율 API가 모두 실패할 때 쓸 원/달러 값
USD_KRW_FALLBACK=1400
