# 대시보드 주소 (배포 주소 또는 http://localhost:3300)
DASHBOARD_URL=http://localhost:3300

# 대시보드 서버의 INGEST_TOKEN과 같은 값
INGEST_TOKEN=

# 대시보드에 보일 이 맥의 이름 (비우면 컴퓨터 이름)
AGENT_HOST_NAME=

# 0으로 두면 Claude/Codex 계정의 남은 한도 조회를 끈다 (사용 기록 집계는 계속함)
AGENT_LIVE_LIMITS=1

# 0으로 두면 맥 알림 수집을 끈다
AGENT_MAC_NOTIFICATIONS=1

# --watch 로 돌릴 때 간격(초)
AGENT_INTERVAL=120
