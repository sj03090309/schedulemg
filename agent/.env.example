# 대시보드 주소 (배포 주소 또는 http://localhost:3300)
DASHBOARD_URL=http://localhost:3300

# 대시보드 서버의 INGEST_TOKEN과 같은 값
INGEST_TOKEN=

# 대시보드에 보일 이 맥의 이름 (비우면 컴퓨터 이름)
AGENT_HOST_NAME=

# 0으로 두면 Claude/Codex 계정의 남은 한도 조회를 끈다 (사용 기록 집계는 계속함)
AGENT_LIVE_LIMITS=1

# Claude CLI 로그인 토큰이 만료되면 CLI를 없는 모델로 한 번 실행해 갱신한다 (사용량 안 씀). 0이면 끔
AGENT_REFRESH_CLAUDE_LOGIN=1

# 중요 메일 요약: 이 맥의 Claude Code(구독)로 최근 메일을 판단·요약한다. 0이면 끔
AGENT_MAIL_SUMMARY=1
# 요약에 쓸 모델 (비우면 Claude Code 기본 모델, 예: sonnet, haiku, opus)
AGENT_SUMMARY_MODEL=

# 0으로 두면 맥 알림 수집을 끈다
AGENT_MAC_NOTIFICATIONS=1

# --watch 로 돌릴 때 간격(초)
AGENT_INTERVAL=120
